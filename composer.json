{
    "name": "invis1ble/messenger-bundle",
    "type": "symfony-bundle",
    "description": "Symfony Bundle for the Bus and Message Interfaces and Implementations.",
    "authors": [
        {
            "name": "Invis1ble",
            "email": "Invis1ble@users.noreply.github.com"
        }
    ],
    "keywords": [
        "event",
        "command",
        "query",
        "messenger",
        "message-bus",
        "event-bus",
        "command-bus",
        "query-bus",
        "cqrs",
        "symfony-bundle"
    ],
    "require": {
        "php": ">=8.2",
        "invis1ble/messenger": "^5.1",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "escapestudios/symfony2-coding-standard": "^3.18",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.5",
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Invis1ble\\MessengerBundle\\": "src/",
            "Invis1ble\\MessengerBundle\\Tests\\": "tests/"
        },
        "exclude-from-classmap": ["/tests/"]
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "bash bin/php_codesniffer",
            "bash bin/php-cs-fixer"
        ],
        "check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@lint",
            "@test"
        ]
    },
    "license": "MIT"
}
